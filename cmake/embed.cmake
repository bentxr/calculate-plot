# Script mode: writes OUTPUT, a C++ file holding each file of FILES (relative to SOURCE_DIR) byte for
# byte, found by calculate_plot::embedded::file("relative/path").
set(body "")
set(table "")
set(index 0)
foreach(path IN LISTS FILES)
    file(READ "${SOURCE_DIR}/${path}" hex HEX)
    string(LENGTH "${hex}" hexlength)
    math(EXPR size "${hexlength} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
    string(APPEND body "const char data${index}[] = {${bytes} 0};\n")
    string(APPEND table "    if (path == \"${path}\") return {data${index}, ${size}};\n")
    math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${OUTPUT}.new"
"// Generated by cmake/embed.cmake: do not edit.
#include \"support/embedded.hpp\"

namespace calculate_plot::embedded {

namespace {
${body}}  // namespace

std::string_view file(std::string_view path) {
${table}    return {};
}

}  // namespace calculate_plot::embedded
")
file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.new")
