# The notices that must travel with the library: NOTICE first, then the licence texts of every
# component that is compiled into it ("use": "runtime" in licensing/manifest.json).
function(calculate_plot_notice_files out)
    file(READ "${PROJECT_SOURCE_DIR}/licensing/manifest.json" manifest)
    set(files NOTICE)
    string(JSON count LENGTH "${manifest}" components)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON use GET "${manifest}" components ${i} use)
            if(use STREQUAL "runtime")
                string(JSON nfiles LENGTH "${manifest}" components ${i} licenceFiles)
                math(EXPR lastfile "${nfiles} - 1")
                foreach(j RANGE ${lastfile})
                    string(JSON path GET "${manifest}" components ${i} licenceFiles ${j} path)
                    list(APPEND files "${path}")
                endforeach()
            endif()
        endforeach()
    endif()
    set(${out} ${files} PARENT_SCOPE)
endfunction()

# Script mode: writes OUTPUT, a C++ file holding each file of FILES (relative to SOURCE_DIR) byte for byte.
if(CMAKE_SCRIPT_MODE_FILE)
    set(body "")
    set(table "")
    set(index 0)
    foreach(path IN LISTS FILES)
        file(READ "${SOURCE_DIR}/${path}" hex HEX)
        string(LENGTH "${hex}" hexlength)
        math(EXPR size "${hexlength} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
        string(APPEND body "const char text${index}[] = {${bytes} 0};\n")
        string(APPEND table "        {\"${path}\", {text${index}, ${size}}},\n")
        math(EXPR index "${index} + 1")
    endforeach()
    file(WRITE "${OUTPUT}.new"
"// Generated by cmake/notices.cmake from NOTICE and LICENSES/: do not edit.
#include \"calculate-plot/calculate-plot.hpp\"

namespace calculate_plot {

namespace {
${body}}  // namespace

std::vector<LicenceText> licenceTexts() {
    return {
${table}    };
}

}  // namespace calculate_plot
")
    file(COPY_FILE "${OUTPUT}.new" "${OUTPUT}" ONLY_IF_DIFFERENT)
    file(REMOVE "${OUTPUT}.new")
endif()
