{"version": 1, "calls": [{"call": "subplots", "args": [1, 2], "as": ["fig", "axs"]},
 {"on": "axs[0]", "call": "plot", "args": [[0, 1], [0, 1]]},
 {"on": "axs[0]", "call": "annotate", "args": ["far to the left of the axes", [0, 0.5]], "kwargs": {"xytext": [-60, 0], "textcoords": "offset points", "ha": "right"}},
 {"on": "axs[1]", "call": "plot", "args": [[0, 1], [0, 1]]},
 {"on": "axs[1]", "call": "annotate", "args": ["below", [0.5, 0]], "kwargs": {"xycoords": "axes fraction", "xytext": [0, -40], "textcoords": "offset points"}},
 {"on": "axs[1]", "call": "annotate", "args": ["clipped away", [5, 5]], "kwargs": {"xytext": [0, 0.5], "textcoords": "axes fraction"}},
 {"on": "fig", "call": "tight_layout"}]}
