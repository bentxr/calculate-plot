{"version": 1, "calls": [{"call": "subplots", "args": [2, 2], "kwargs": {"figsize": {"$tuple": [7.2, 5.4]}}, "as": ["fig", "axs"]},
 {"on": "axs[0, 0]", "call": "bar", "args": [[1, 2, 3, 4], [3, -2, 5, 1.5]], "kwargs": {"yerr": [0.5, 0.3, 0.2, 0.1]}, "as": "bars"},
 {"on": "axs[0, 0]", "call": "bar_label", "args": [{"$ref": "bars"}]},
 {"on": "axs[0, 0]", "call": "bar_label", "args": [{"$ref": "bars"}], "kwargs": {"label_type": "center", "fmt": "%.1f", "color": "w"}},
 {"on": "axs[0, 1]", "call": "barh", "args": [[1, 2, 3], [4, -1, 2.5]], "as": "hb"},
 {"on": "axs[0, 1]", "call": "set_xlim", "args": [6, -3]},
 {"on": "axs[0, 1]", "call": "bar_label", "args": [{"$ref": "hb"}, ["a", "b", "c"]], "kwargs": {"padding": 3}},
 {"on": "axs[1, 0]", "call": "bar", "args": [[0, 1, 2, 3], [7, 3, 0, 12]], "as": "ib"},
 {"on": "axs[1, 0]", "call": "set_ylim", "args": [0, 10]},
 {"on": "axs[1, 0]", "call": "bar_label", "args": [{"$ref": "ib"}], "kwargs": {"fmt": "{:.2f}", "padding": [1, 2, 3, 4]}},
 {"on": "axs[1, 0]", "call": "bar_label", "args": [{"$ref": "ib"}], "kwargs": {"fmt": "%d%%", "label_type": "center", "fontsize": 8}},
 {"on": "axs[1, 1]", "call": "bar", "args": [[1, 2, 3], [{"$float": "nan"}, 2, -1]], "kwargs": {"bottom": 0.5}, "as": "nb"},
 {"on": "axs[1, 1]", "call": "set_ylim", "args": [3, -2]},
 {"on": "axs[1, 1]", "call": "bar_label", "args": [{"$ref": "nb"}], "kwargs": {"fmt": "%s"}}]}
