 {"on": "axs[1]", "call": "boxplot", "args": [[[1, 3, 4, 6, 90], [2, 4, 4, 5, 7, 12]]], "kwargs": {"orientation": "horizontal", "positions": [0.5, 20], "tick_labels": ["a", "b"]}},
 {"on": "axs[2]", "call": "boxplot", "args": [[[1, 3, 4, 6, 9]]]},
 {"on": "axs[2]", "call": "set_xscale", "args": ["log"]}]}
