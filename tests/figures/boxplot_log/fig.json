{"version": 1, "calls": [{"call": "subplots", "args": [1, 3], "kwargs": {"figsize": {"$tuple": [7.2, 3]}}, "as": ["fig", "axs"]},
 {"on": "axs[0]", "call": "semilogx"},
 {"on": "axs[0]", "call": "boxplot", "args": [[[1, 3, 4, 6, 9], [2, 4, 4, 5, 7, 12], [0.5, 1, 8]]]},
