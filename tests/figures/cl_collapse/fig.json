{"version": 1, "calls": [{"call": "subplots", "args": [3, 3], "kwargs": {"layout": "constrained", "figsize": {"$tuple": [1.2, 1.0]}}, "as": ["fig", "axs"]},
 {"on": "axs[0, 0]", "call": "set_title", "args": ["a title much wider than the figure"]},
