{"version": 1, "calls": [{"call": "figure", "kwargs": {"layout": "constrained", "figsize": {"$tuple": [7.0, 5.5]}}, "as": "fig"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, {"$tuple": [1, 2]}], "as": "top"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, 3], "as": "corner"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, {"$tuple": [4, 7]}], "as": "tall"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, 5], "as": "mid"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, {"$tuple": [6, 9]}], "as": "right"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, 8], "as": "low"},
 {"on": "top", "call": "plot", "args": [[0, 1, 2], [10000, 20000, 15000]]},
 {"on": "top", "call": "set_ylabel", "args": ["a long label\non two lines"]},
 {"on": "top", "call": "set_title", "args": ["spans two columns"]},
 {"on": "corner", "call": "plot", "args": [[0, 1], [0, 1]]},
 {"on": "corner", "call": "set_xlabel", "args": ["x of the corner"]},
 {"on": "tall", "call": "plot", "args": [[0, 1, 2], [-1000, 0, 1000]]},
 {"on": "tall", "call": "set_ylabel", "args": ["spans two rows, with a long label"]},
 {"on": "tall", "call": "set_xlabel", "args": ["x\nof the tall one"]},
 {"on": "mid", "call": "plot", "args": [[0, 1], [1, 0]]},
 {"on": "mid", "call": "set_title", "args": ["a title\non two lines"]},
 {"on": "right", "call": "plot", "args": [[0, 1, 2], [3, 1, 2]]},
 {"on": "right", "call": "set_ylabel", "args": ["right"]},
 {"on": "right.yaxis", "call": "set_label_position", "args": ["right"]},
 {"on": "low", "call": "plot", "args": [[0, 100000], [0, 1]]},
 {"on": "low", "call": "set_xlabel", "args": ["the lowest x label,\nthree lines\nlong"]}]}
