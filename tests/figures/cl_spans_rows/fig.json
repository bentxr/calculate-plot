{"version": 1, "calls": [{"call": "figure", "kwargs": {"layout": "constrained", "figsize": {"$tuple": [6.0, 6.0]}}, "as": "fig"},
 {"on": "fig", "call": "add_subplot", "args": [3, 2, {"$tuple": [1, 3]}], "as": "a"},
 {"on": "fig", "call": "add_subplot", "args": [3, 2, 2], "as": "b"},
 {"on": "fig", "call": "add_subplot", "args": [3, 2, {"$tuple": [4, 6]}], "as": "c"},
 {"on": "fig", "call": "add_subplot", "args": [3, 2, 5], "as": "d"},
 {"on": "a", "call": "plot", "args": [[0, 1], [0, 1]]},
 {"on": "a", "call": "set_title", "args": ["a title over\ntwo rows of cells"]},
 {"on": "b", "call": "plot", "args": [[0, 1], [5, 1]]},
 {"on": "b", "call": "set_xlabel", "args": ["b's x\nlabel"]},
 {"on": "c", "call": "plot", "args": [[0, 1], [1, 3]]},
 {"on": "c", "call": "set_xlabel", "args": ["c spans the two lower rows"]},
 {"on": "c", "call": "set_title", "args": ["c"]},
 {"on": "d", "call": "plot", "args": [[0, 1], [2, 1]]},
 {"on": "d", "call": "set_title", "args": ["d,\nwith a tall\ntitle"]},
 {"on": "fig", "call": "suptitle", "args": ["rows that span"]}]}
