{"version": 1, "calls": [{"call": "figure", "kwargs": {"layout": "constrained", "figsize": {"$tuple": [7.0, 6.0]}}, "as": "fig"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, {"$tuple": [1, 3]}], "as": "top"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, 4], "as": "a"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, 5], "as": "b"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, 6], "as": "c"},
 {"on": "fig", "call": "add_subplot", "args": [3, 3, {"$tuple": [7, 9]}], "as": "bottom"},
 {"on": "top", "call": "plot", "args": [[0, 1], [0, 1]]}, {"on": "top", "call": "set_title", "args": ["three columns"]},
 {"on": "a", "call": "plot", "args": [[0, 1], [0, 1]]}, {"on": "a", "call": "set_ylabel", "args": ["a, on the right,\nin two lines"]},
 {"on": "a.yaxis", "call": "set_label_position", "args": ["right"]},
 {"on": "b", "call": "plot", "args": [[0, 1], [0, 100000]]}, {"on": "b", "call": "set_ylabel", "args": ["b's label\nof three\nlines"]},
 {"on": "c", "call": "plot", "args": [[0, 1], [0, 1]]}, {"on": "c", "call": "set_ylabel", "args": ["c"]},
 {"on": "bottom", "call": "plot", "args": [[0, 1], [1, 0]]}, {"on": "bottom", "call": "set_xlabel", "args": ["also three columns"]}]}
