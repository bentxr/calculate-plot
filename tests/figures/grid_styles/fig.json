  {"on": "ax", "call": "plot", "args": [[1, 10, 100, 1000], [1, 3, 2, 5]]},
  {"on": "ax", "call": "set_xscale", "args": ["log"]},
  {"on": "ax", "call": "grid", "kwargs": {"which": "both", "axis": "x", "color": "0.6", "ls": ":", "lw": 0.5}},
  {"on": "ax", "call": "grid", "kwargs": {"axis": "y", "color": "#ff000080", "linewidth": 1.5}}
]}
