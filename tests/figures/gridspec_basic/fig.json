{"version": 1, "calls": [
  {"call": "figure", "kwargs": {"figsize": {"$tuple": [7.0, 5.0]}}, "as": "fig"},
  {"on": "fig", "call": "add_gridspec", "args": [3, 3], "kwargs": {"width_ratios": [1, 2, 1], "hspace": 0.45, "left": 0.08, "right": 0.97, "figure": null}, "as": "gs"},
  {"on": "fig", "call": "add_subplot", "args": [{"$ref": "gs[0, :]"}], "as": "top"},
  {"on": "top", "call": "plot", "args": [[0, 1, 2, 3], [1, 3, 2, 4]]},
  {"on": "top", "call": "set_title", "args": ["gs[0, :]"]},
  {"on": "fig", "call": "add_subplot", "args": [{"$ref": "gs[1, :-1]"}], "as": "mid"},
  {"on": "mid", "call": "set_title", "args": ["gs[1, :-1]"]},
  {"on": "fig", "call": "add_subplot", "args": [{"$ref": "gs[1:, -1]"}], "kwargs": {"projection": "polar"}},
  {"on": "fig", "call": "add_subplot", "args": [{"$ref": "gs[-1, 0]"}]},
  {"on": "fig", "call": "add_subplot", "args": [{"$ref": "gs[7]"}], "as": "flat"},
  {"on": "flat", "call": "set_title", "args": ["gs[7]"]},
  {"call": "subplot", "args": [{"$ref": "gs[0, :]"}]},
  {"call": "plot", "args": [[0, 3], [4, 1]], "kwargs": {"color": "C3"}},
  {"call": "subplot", "args": [{"$ref": "gs[1, 0:2:1]"}]},
  {"call": "plot", "args": [[0, 1], [0, 1]]}
]}
