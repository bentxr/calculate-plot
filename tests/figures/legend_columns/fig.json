  {"on": "axs[0]", "call": "plot", "args": [[1, 2, 3], [2, 1, 0]], "kwargs": {"label": "three"}},
  {"on": "axs[0]", "call": "legend", "args": [], "kwargs": {"ncols": 1, "ncol": 2.9}},
  {"on": "axs[1]", "call": "plot", "args": [[1, 2, 3], [0, 2, 1]], "kwargs": {"label": "one"}},
  {"on": "axs[1]", "call": "plot", "args": [[1, 2, 3], [1, 0, 2]], "kwargs": {"label": "two"}},
