{"version": 1, "calls": [
  {"call": "subplots", "args": [2, 3], "kwargs": {"figsize": {"$tuple": [11.0, 6.5]}}, "as": ["fig", "axs"]},
  {"on": "axs[0, 0]", "call": "errorbar", "args": [[0, 1, 2, 3], [1, 2, 1.5, 3]], "kwargs": {"yerr": 0.3, "label": "y errors"}},
  {"on": "axs[0, 0]", "call": "legend", "args": []},
  {"on": "axs[0, 1]", "call": "errorbar", "args": [[0, 1, 2, 3], [1, 2, 1.5, 3]], "kwargs": {"yerr": [0.1, 0.2, 0.3, 0.4], "fmt": "o", "capsize": 4, "label": "points with caps"}},
  {"on": "axs[0, 1]", "call": "plot", "args": [[0, 3], [1, 3]], "kwargs": {"label": "a line, listed first"}},
  {"on": "axs[0, 1]", "call": "legend", "args": [], "kwargs": {"loc": "upper left"}},
  {"on": "axs[0, 2]", "call": "errorbar", "args": [[0, 1, 2, 3], [1, 2, 1.5, 3]], "kwargs": {"xerr": 0.2, "fmt": "none", "ecolor": "C3", "label": "bars only, x"}},
  {"on": "axs[0, 2]", "call": "errorbar", "args": [[0, 1, 2, 3], [2, 3, 2.5, 4]], "kwargs": {"xerr": 0.2, "fmt": "none", "capsize": 3, "label": "x bars with caps"}},
  {"on": "axs[0, 2]", "call": "legend", "args": []},
  {"on": "axs[1, 0]", "call": "errorbar", "args": [[0, 1, 2, 3], [1, 2, 1.5, 3]], "kwargs": {"xerr": 0.15, "yerr": 0.4, "fmt": "s--", "capsize": 5, "capthick": 2, "elinewidth": 0.8, "ecolor": "k", "color": "C2", "markersize": 9, "label": "both, squares"}},
  {"on": "axs[1, 0]", "call": "legend", "args": [], "kwargs": {"fontsize": 14}},
  {"on": "axs[1, 1]", "call": "errorbar", "args": [[0, 1, 2, 3], [1, 2, 1.5, 3]], "kwargs": {"yerr": 0.3, "alpha": 0.5, "linewidth": 3, "label": "half there, thick"}},
  {"on": "axs[1, 1]", "call": "errorbar", "args": [[0, 1, 2, 3], [0, 1, 0.5, 2]], "kwargs": {"yerr": 0.3, "label": "_not listed"}},
  {"on": "axs[1, 1]", "call": "errorbar", "args": [[0, 1, 2, 3], [3, 4, 3.5, 5]], "kwargs": {"yerr": 0.3, "fmt": "^", "mfc": "none", "mec": "C4", "label": "open triangles"}},
  {"on": "axs[1, 1]", "call": "scatter", "args": [[0, 1, 2], [5, 5.5, 6]], "kwargs": {"label": "points, before the bars"}},
  {"on": "axs[1, 1]", "call": "legend", "args": [], "kwargs": {"ncols": 2, "fontsize": 7}},
  {"on": "axs[1, 2]", "call": "errorbar", "args": [[1, 10, 100], [1, 10, 100]], "kwargs": {"yerr": [0.5, 5, 50], "xerr": [0.2, 2, 20], "fmt": ".", "label": "on log axes"}},
  {"on": "axs[1, 2]", "call": "set_xscale", "args": ["log"]},
  {"on": "axs[1, 2]", "call": "set_yscale", "args": ["log"]},
  {"on": "axs[1, 2]", "call": "legend", "args": [], "kwargs": {"loc": "best", "title": "Measured"}}
]}
