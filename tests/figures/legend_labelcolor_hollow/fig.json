{"version": 1,
 "rc": {"markers.fillstyle": "none", "legend.labelcolor": "markerfacecolor"},
 "calls": [
  {"call": "subplots", "args": [1, 3], "kwargs": {"figsize": {"$tuple": [10.0, 3.5]}}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "plot", "args": [[1, 2, 3], [1, 2, 1], "o-"], "kwargs": {"label": "hollow markers", "color": "C1"}},
  {"on": "axs[0]", "call": "errorbar", "args": [[1, 2, 3], [2, 3, 2]], "kwargs": {"yerr": 0.3, "xerr": 0.2, "label": "both bars", "fmt": "s", "color": "C2", "ecolor": "C3"}},
  {"on": "axs[0]", "call": "vlines", "args": [[1.5, 2.5], 0, 3], "kwargs": {"label": "wide lines", "colors": "C4", "linewidths": 4, "linestyles": "dashed"}},
  {"on": "axs[0]", "call": "axvspan", "args": [1.8, 2.2], "kwargs": {"label": "span", "color": "C5", "alpha": 0.4}},
  {"on": "axs[0]", "call": "legend", "args": []},
  {"on": "axs[1]", "call": "plot", "args": [[1, 2, 3], [1, 2, 1], "o-"], "kwargs": {"label": "hollow markers", "color": "C1"}},
  {"on": "axs[1]", "call": "errorbar", "args": [[1, 2, 3], [2, 3, 2]], "kwargs": {"yerr": 0.3, "xerr": 0.2, "label": "both bars", "fmt": "s", "color": "C2", "ecolor": "C3"}},
  {"on": "axs[1]", "call": "vlines", "args": [[1.5, 2.5], 0, 3], "kwargs": {"label": "wide lines", "colors": "C4", "linewidths": 4, "linestyles": "dashed"}},
  {"on": "axs[1]", "call": "axvspan", "args": [1.8, 2.2], "kwargs": {"label": "span", "color": "C5", "alpha": 0.4}},
  {"on": "axs[1]", "call": "errorbar", "args": [[1, 2, 3], [2.5, 3.5, 2.5]], "kwargs": {"yerr": 0.3, "xerr": 0.2, "label": "more bars", "fmt": "none", "ecolor": "C7"}},
  {"on": "axs[1]", "call": "legend", "args": [], "kwargs": {"labelcolor": "linecolor"}},
  {"on": "axs[2]", "call": "plot", "args": [[1, 2, 3], [1, 2, 1], "o-"], "kwargs": {"label": "hollow markers", "color": "C1", "markeredgecolor": "C6"}},
  {"on": "axs[2]", "call": "errorbar", "args": [[1, 2, 3], [2, 3, 2]], "kwargs": {"yerr": 0.3, "xerr": 0.2, "label": "both bars", "fmt": "s", "color": "C2", "ecolor": "C3"}},
  {"on": "axs[2]", "call": "vlines", "args": [[1.5, 2.5], 0, 3], "kwargs": {"label": "wide lines", "colors": "C4", "linewidths": 4, "linestyles": "dashed"}},
  {"on": "axs[2]", "call": "axvspan", "args": [1.8, 2.2], "kwargs": {"label": "span", "color": "C5", "alpha": 0.4}},
  {"on": "axs[2]", "call": "legend", "args": [], "kwargs": {"labelcolor": "mec"}}
]}
