{"version": 1, "rc": {"legend.handleheight": 1.4},
 "calls": [
  {"call": "subplots", "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[0, 1], [0, 1]], "kwargs": {"label": "one"}},
  {"on": "ax", "call": "plot", "args": [[0, 1], [0, 2]], "kwargs": {"label": "two\nlines"}},
  {"on": "ax", "call": "plot", "args": [[0, 1], [0, 3]], "kwargs": {"label": "three", "marker": "o"}},
  {"on": "ax", "call": "plot", "args": [[0, 1], [0, 4]], "kwargs": {"label": "four"}},
  {"on": "ax", "call": "plot", "args": [[0, 1], [0, 5]], "kwargs": {"label": "five"}},
  {"on": "ax", "call": "legend", "kwargs": {"ncols": 2, "loc": "upper left"}}
]}
