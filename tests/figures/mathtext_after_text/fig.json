{"version": 1, "calls": [
  {"call": "subplots", "args": [], "kwargs": {"figsize": {"$tuple": [6.0, 4.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[0, 1, 2], [0, 1, 4]]},
  {"on": "ax", "call": "text", "args": [0.1, 3.5, "plain first: 中 ∑ ℏ ⨁ ䷀"], "kwargs": {"fontsize": 14}},
  {"on": "ax", "call": "text", "args": [0.1, 2.5, "$then\\ math: 中 ∑ ℏ ⨁ ䷀ x$"], "kwargs": {"fontsize": 14}},
  {"on": "ax", "call": "text", "args": [0.1, 1.5, "and serif: 中 ⨁ ䷀"], "kwargs": {"fontsize": 14, "family": "serif"}},
  {"on": "ax", "call": "text", "args": [0.1, 0.5, "$\\mathrm{中 ⨁ ䷀}\\mathit{中 ⨁ ䷀}\\mathbf{中}$"], "kwargs": {"fontsize": 14}},
  {"on": "ax", "call": "set_title", "args": ["$中 ∑ ℏ ⨁$ in the title, drawn last"]},
  {"on": "ax", "call": "set_xlabel", "args": ["plain label 文"]}
]}
