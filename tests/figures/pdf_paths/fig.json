{"version": 1, "calls": [
  {"call": "figure", "kwargs": {"figsize": {"$tuple": [5.0, 2.5]}}, "as": "fig"},
  {"on": "fig", "call": "add_subplot", "args": [1, 2, 1], "as": "ax"},
  {"on": "fig", "call": "add_subplot", "args": [1, 2, 2], "kwargs": {"projection": "polar"}, "as": "pax"},
  {"on": "ax", "call": "plot", "args": [[0, 1, 2, 3], [0, 2, 1, 3]], "kwargs": {"linewidth": 4, "solid_capstyle": "round", "solid_joinstyle": "miter"}},
  {"on": "ax", "call": "plot", "args": [[0, 1, 2, 3], [3, 1, 2, 0]], "kwargs": {"linestyle": "--", "color": "0.4", "alpha": 0.5}},
  {"on": "ax", "call": "plot", "args": [[0, 3], [1.5, 1.5]], "kwargs": {"linestyle": "-.", "color": [0.2, 0.6, 0.3, 0.7], "dash_capstyle": "projecting"}},
  {"on": "ax", "call": "plot", "args": [[-1, 4], [-1, 4]], "kwargs": {"linestyle": ":", "color": "C3", "linewidth": 0.5}},
  {"on": "ax", "call": "fill", "args": [[0.5, 1.5, 1.0], [0.5, 0.5, 2.5]], "kwargs": {"facecolor": "C4", "edgecolor": "k", "alpha": 0.6}},
  {"on": "ax", "call": "fill", "args": [[2.0, 2.8, 2.8, 2.0], [2.0, 2.0, 2.8, 2.8]], "kwargs": {"fill": false, "edgecolor": "C5", "linewidth": 2}},
  {"on": "ax", "call": "fill", "args": [[2.0, 3.0, 2.5], [0.0, 0.0, 0.8]], "kwargs": {"facecolor": [0.5, 0.5, 0.5], "linewidth": 0}},
  {"on": "ax", "call": "plot", "args": [[0.2, 0.6, 1.0], [2.9, 2.2, 2.9]], "kwargs": {"linewidth": 5, "solid_joinstyle": "bevel", "color": "0"}},
  {"on": "ax", "call": "set_xlim", "args": [0, 3]},
  {"on": "ax", "call": "set_ylim", "args": [0, 3]},
  {"on": "ax", "call": "axis", "args": ["off"]},
  {"on": "pax", "call": "plot", "args": [[0, 1, 2, 3, 4, 5, 6], [1, 2, 3, 4, 5, 6, 7]], "kwargs": {"color": "C0", "linewidth": 3}},
  {"on": "pax", "call": "set_rmax", "args": [5]},
  {"on": "pax", "call": "axis", "args": ["off"]}
]}
