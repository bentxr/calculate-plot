{"version": 1, "rc": {"savefig.bbox": "tight"}, "calls": [
  {"call": "figure", "kwargs": {"figsize": {"$tuple": [5.0, 3.0]}}, "as": "fig"},
  {"on": "fig", "call": "add_subplot", "args": [121], "kwargs": {"projection": "polar"}, "as": "p"},
  {"on": "p", "call": "plot", "args": [[0, 1, 2, 3], [1, 2, 1, 3]], "kwargs": {"label": "line"}},
  {"on": "p", "call": "fill", "args": [[0, 1, 2], [0.5, 1, 0.5]], "kwargs": {"alpha": 0.4}},
  {"on": "p", "call": "set_title", "args": ["polar"]},
  {"on": "fig", "call": "add_subplot", "args": [122], "as": "ax"},
  {"on": "ax", "call": "plot", "args": [[0, 1], [1, 0]]}
]}
