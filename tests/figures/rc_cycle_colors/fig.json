{"version": 1,
 "rc": {"axes.prop_cycle": "cycler('color', ['r', '0.4', '#00aa0080', (0, 0, 1), 'E24A33'])"},
 "calls": [
  {"call": "subplots", "args": [1, 2], "kwargs": {"figsize": {"$tuple": [6.0, 3.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1], [0, 1], [0, 1], [1, 2], [0, 1], [2, 3], [0, 1], [3, 4]]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1], [4, 5]]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1], [5, 6]]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1], [6, 7]], "kwargs": {"color": "C1"}},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1], [7, 8], "k--"]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1], [8, 9]]},
  {"on": "axs[0]", "call": "axhline", "args": [4.5], "kwargs": {"color": "C3"}},
  {"on": "axs[0]", "call": "set_title", "args": ["C4"], "kwargs": {"color": "C4"}},
  {"on": "axs[1]", "call": "scatter", "args": [[1, 2, 3], [1, 2, 3]]},
  {"on": "axs[1]", "call": "fill_between", "args": [[1, 2, 3], [0, 1, 0], [1, 2, 1]]},
  {"on": "axs[1]", "call": "scatter", "args": [[1, 2, 3], [3, 2, 1]]},
  {"on": "axs[1]", "call": "errorbar", "args": [[1, 2, 3], [2, 2, 2]], "kwargs": {"yerr": 0.3, "capsize": 3}},
  {"on": "axs[1]", "call": "errorbar", "args": [[1, 2, 3], [2.5, 2.5, 2.5]], "kwargs": {"yerr": 0.2, "fmt": "none"}},
  {"on": "axs[1]", "call": "plot", "args": [[1, 3], [0.5, 0.5]]},
  {"on": "axs[1]", "call": "vlines", "args": [[1.5, 2.5], 0, 3]}
]}
