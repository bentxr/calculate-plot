{"version": 1,
 "rc": {"axes.prop_cycle": "cycler(lw=[1, 3]) * cycler(ls=['-', '--'])"},
 "calls": [
  {"call": "subplots", "args": [], "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[0, 1], [0, 1], [0, 1], [1, 2], [0, 1], [2, 3], [0, 1], [3, 4], [0, 1], [4, 5]]},
  {"on": "ax", "call": "plot", "args": [[0, 1], [5, 6]], "kwargs": {"color": "C2", "lw": 2, "ls": ":"}},
  {"on": "ax", "call": "plot", "args": [[0, 1], [6, 7]], "kwargs": {"color": "C2"}},
  {"on": "ax", "call": "scatter", "args": [[0.2, 0.8], [1, 5]]},
  {"on": "ax", "call": "scatter", "args": [[0.3, 0.7], [1, 5]]},
  {"on": "ax", "call": "fill_between", "args": [[0, 1], [6.5, 6.5], [7, 7.5]], "kwargs": {"alpha": 0.5}},
  {"on": "ax", "call": "errorbar", "args": [[0.5], [3.5]], "kwargs": {"yerr": 0.5, "capsize": 5}}
]}
