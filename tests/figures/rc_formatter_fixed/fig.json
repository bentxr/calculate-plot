{"version": 1,
 "rc": {"axes.formatter.limits": "3, 3", "axes.formatter.use_mathtext": true, "axes.unicode_minus": false, "savefig.bbox": "tight"},
 "calls": [
  {"call": "subplots", "args": [1, 3], "kwargs": {"figsize": {"$tuple": [9.0, 3.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "plot", "args": [[1, 2, 3, 4], [-1500.0, 2500.0, 1000.0, 7000.0]]},
  {"on": "axs[1]", "call": "plot", "args": [[-1, 2, 3, 4], [-0.5, 0.25, 0.1, 0.7]]},
  {"on": "axs[2]", "call": "plot", "args": [[1000000, 1000001, 1000002], [-1e-7, 1e-7, 2e-7]]}
]}
