{"version": 1,
 "rc": {"axes.formatter.use_mathtext": "yes", "axes.formatter.offset_threshold": 2, "axes.formatter.min_exponent": 3},
 "calls": [
  {"call": "subplots", "args": [2, 2], "kwargs": {"figsize": {"$tuple": [8.0, 5.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0, 0]", "call": "plot", "args": [[1, 2, 3, 4], [-1234500.0, -1234502.5, -1234501.0, -1234507.0]]},
  {"on": "axs[0, 1]", "call": "plot", "args": [[100, 101, 102, 103], [-3e-7, 1e-7, 2e-7, 5e-7]]},
  {"on": "axs[1, 0]", "call": "plot", "args": [[-0.5, 0, 0.5, 1], [2.5e8, 3e8, 9.99e8, 1e9]]},
  {"on": "axs[1, 1]", "call": "plot", "args": [[0.001, 0.01, 0.1, 1, 10, 100, 1000, 10000], [0.2, 0.3, 0.5, 0.9, 2, 4, 6, 7]]},
  {"on": "axs[1, 1]", "call": "set_xscale", "args": ["log"]},
  {"on": "axs[1, 1]", "call": "set_yscale", "args": ["log"]},
  {"on": "fig", "call": "tight_layout", "args": []}
]}
