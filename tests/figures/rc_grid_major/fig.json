{"version": 1,
 "rc": {"axes.grid": 1, "axes.grid.which": "major", "axes.grid.axis": "both", "grid.linestyle": "DASHED",
        "grid.color": "ff000080", "grid.linewidth": "1.5"},
 "calls": [
  {"call": "subplots", "args": [1, 2], "kwargs": {"figsize": {"$tuple": [7.0, 3.0]}, "sharey": true}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1, 2, 3], [1, 3, 2, 5]]},
  {"on": "axs[1]", "call": "plot", "args": [[1, 2, 3, 4], [1, 3, 2, 5]]},
  {"on": "axs[1]", "call": "set_yscale", "args": ["log"]},
  {"on": "axs[1]", "call": "grid", "args": [false], "kwargs": {"axis": "x"}}
]}
