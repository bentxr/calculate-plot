{"version": 1,
 "rc": {"hatch.color": "none"},
 "calls": [
  {"call": "subplots", "args": [], "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "scatter", "args": [[1, 2, 3], [1, 3, 2]], "kwargs": {"alpha": 0.5}},
  {"on": "ax", "call": "scatter", "args": [[1, 2, 3], [2, 4, 3]], "kwargs": {"c": [0.1, 0.5, 0.9], "edgecolors": "none"}},
  {"on": "ax", "call": "fill_between", "args": [[1, 2, 3], [0, 1, 0], [1, 2, 1]], "kwargs": {"alpha": 0.3}},
  {"on": "ax", "call": "vlines", "args": [[1.5, 2.5], 0, 4]},
  {"on": "ax", "call": "scatter", "args": [[2], [0.5]], "kwargs": {"marker": "x"}}
]}
