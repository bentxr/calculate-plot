{"version": 1,
 "rc": {"xtick.minor.visible": "yes", "ytick.minor.visible": true, "xtick.minor.ndivs": 2, "ytick.minor.ndivs": "3", "xtick.minor.size": 4,
        "ytick.minor.width": 1.5, "xtick.top": true, "ytick.right": true, "xtick.direction": "in", "xtick.minor.top": false},
 "calls": [
  {"call": "subplots", "args": [1, 3], "kwargs": {"figsize": {"$tuple": [9.0, 3.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1, 2, 3], [1, 3, 2, 5]]},
  {"on": "axs[1]", "call": "plot", "args": [[0.001, 0.002, 0.003], [10, 30, 20]]},
  {"on": "axs[1]", "call": "grid", "args": [true], "kwargs": {"which": "minor", "axis": "y"}},
  {"on": "axs[2]", "call": "plot", "args": [[1, 2, 3], [0, 5, 2]]},
  {"on": "axs[2]", "call": "set_xscale", "args": ["log"]},
  {"on": "fig", "call": "tight_layout", "args": []},
  {"on": "axs[2]", "call": "set_xscale", "args": ["linear"]}
]}
