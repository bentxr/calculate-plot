{"version": 1,
 "rc": {"xtick.minor.visible": true, "ytick.minor.visible": true, "xtick.major.bottom": false, "ytick.major.left": false},
 "calls": [
  {"call": "subplots", "args": [2, 5], "kwargs": {"figsize": {"$tuple": [7.0, 2.5]}}, "as": ["fig", "axs"]},
  {"on": "axs[0, 0]", "call": "plot", "args": [[0, 1, 2, 3], [1, 3, 2, 5]]},
  {"on": "axs[0, 1]", "call": "plot", "args": [[0, 250, 500, 1000], [-0.02, 0.01, 0.03, 0.04]]},
  {"on": "axs[1, 2]", "call": "plot", "args": [[1, 2, 3, 4], [1, 30, 200, 5000]]},
  {"on": "axs[1, 3]", "call": "plot", "args": [[12.5, 13.5], [3, 7]]},
  {"on": "axs[1, 4]", "call": "set_yscale", "args": ["log"]}
]}
