{"version": 1,
 "rc": {"xtick.minor.visible": true, "ytick.minor.visible": true, "xtick.minor.ndivs": 0, "ytick.minor.ndivs": 10, "savefig.bbox": "tight"},
 "calls": [
  {"call": "subplots", "args": [2, 2], "kwargs": {"figsize": {"$tuple": [6.0, 4.0]}, "sharex": true, "sharey": "row"}, "as": ["fig", "axs"]},
  {"on": "axs[0, 0]", "call": "plot", "args": [[0, 1, 2, 3], [1, 3, 2, 5]]},
  {"on": "axs[0, 1]", "call": "plot", "args": [[0, 10, 20, 30], [10, 30, 20, 50]]},
  {"on": "axs[1, 0]", "call": "plot", "args": [[5, 6], [0.1, 0.2]]},
  {"on": "axs[1, 1]", "call": "plot", "args": [[5, 6], [0.15, 0.4]]}
]}
