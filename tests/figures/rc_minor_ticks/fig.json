{"version": 1,
 "rc": {"xtick.minor.visible": true, "ytick.minor.visible": true, "axes.grid": true, "axes.grid.which": "both", "grid.alpha": 0.4},
 "calls": [
  {"call": "subplots", "args": [2, 2], "kwargs": {"figsize": {"$tuple": [8.0, 6.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0, 0]", "call": "plot", "args": [[0, 1, 2, 3], [1, 3, 2, 5]]},
  {"on": "axs[0, 1]", "call": "plot", "args": [[0, 250, 500, 1000], [-0.02, 0.01, 0.03, 0.04]]},
  {"on": "axs[1, 0]", "call": "plot", "args": [[1, 2, 3, 4], [1, 30, 200, 5000]]},
  {"on": "axs[1, 0]", "call": "set_yscale", "args": ["log"]},
  {"on": "axs[1, 1]", "call": "plot", "args": [[1234500.0, 1234507.0], [3, 7]]},
  {"on": "axs[1, 1]", "call": "set_xlim", "args": [1234509.0, 1234499.0]},
  {"on": "axs[1, 1]", "call": "set_ylim", "args": [0, 7.5]},
  {"on": "fig", "call": "tight_layout", "args": []}
]}
