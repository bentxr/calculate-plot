{"version": 1,
 "rc": {"xtick.bottom": false, "ytick.major.left": false},
 "calls": [
  {"call": "subplots", "args": [2, 2], "kwargs": {"figsize": {"$tuple": [6.0, 4.0]}, "sharex": "col"}, "as": ["fig", "axs"]},
  {"on": "axs[0, 0]", "call": "plot", "args": [[0.5, 1, 2, 4], [1, 3, 2, 5]]},
  {"on": "axs[0, 1]", "call": "plot", "args": [[0.5, 1, 2, 4], [10, 30, 20, 50]]},
  {"on": "axs[1, 0]", "call": "plot", "args": [[1, 2, 3], [0.1, 0.3, 0.2]]},
  {"on": "axs[1, 1]", "call": "plot", "args": [[1, 2, 3], [1, 100, 10]]},
  {"on": "axs[1, 1]", "call": "set_yscale", "args": ["log"]},
  {"on": "fig", "call": "tight_layout", "args": []}
]}
