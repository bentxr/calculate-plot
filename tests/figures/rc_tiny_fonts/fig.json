{"version": 1,
 "rc": {"font.size": 0.5, "axes.labelsize": 0.3, "axes.titlesize": 0.75, "xtick.labelsize": 0.75, "ytick.labelsize": "0.2",
        "legend.fontsize": 0.2, "legend.title_fontsize": 0.9, "figure.titlesize": 0.4},
 "calls": [
  {"call": "subplots", "args": [1, 2], "kwargs": {"figsize": {"$tuple": [4.0, 2.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1, 2], [1234500.0, 1234502.5, 1234501.0]], "kwargs": {"label": "a line"}},
  {"on": "axs[0]", "call": "set_title", "args": ["A title"]},
  {"on": "axs[0]", "call": "set_xlabel", "args": ["x label"]},
  {"on": "axs[0]", "call": "set_ylabel", "args": ["y label"]},
  {"on": "axs[0]", "call": "legend", "args": [], "kwargs": {"title": "Legend"}},
  {"on": "axs[0]", "call": "text", "args": [1, 1234501.5, "a note"]},
  {"on": "axs[1]", "call": "plot", "args": [[1, 10, 100], [1, 1000, 10]], "kwargs": {"label": "another"}},
  {"on": "axs[1]", "call": "set_xscale", "args": ["log"]},
  {"on": "axs[1]", "call": "legend", "args": [], "kwargs": {"fontsize": 0.5, "title": "T", "title_fontsize": 0.1}},
  {"on": "axs[1]", "call": "set_title", "args": ["sized"], "kwargs": {"fontsize": 0.9}},
  {"on": "fig", "call": "suptitle", "args": ["The figure"]},
  {"on": "fig", "call": "tight_layout", "args": []}
]}
