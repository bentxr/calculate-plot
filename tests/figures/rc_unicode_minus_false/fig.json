{"version": 1,
 "rc": {"axes.unicode_minus": false},
 "calls": [
  {"call": "subplots", "args": [2, 2], "kwargs": {"figsize": {"$tuple": [7.0, 5.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0, 0]", "call": "plot", "args": [[-3, -1, 1, 3], [-2.5, -0.5, 1.5, 3.5]]},
  {"on": "axs[0, 1]", "call": "plot", "args": [[1, 2, 3, 4], [-1234500.0, -1234502.5, -1234501.0, -1234507.0]]},
  {"on": "axs[1, 0]", "call": "plot", "args": [[1e-9, 2e-9, 3e-9], [-1e-7, -3e-7, -2e-7]]},
  {"on": "axs[1, 1]", "call": "plot", "args": [[0.001, 0.01, 0.1, 1], [-5, -1, 0, 4]]},
  {"on": "axs[1, 1]", "call": "set_xscale", "args": ["log"]},
  {"on": "axs[1, 1]", "call": "set_title", "args": ["a title - not a minus; $-x$"]},
  {"on": "fig", "call": "tight_layout", "args": []}
]}
