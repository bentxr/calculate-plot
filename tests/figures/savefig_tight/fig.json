{"version": 1,
 "rc": {"savefig.bbox": "tight"},
 "calls": [
  {"call": "subplots", "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[0, 1, 2], [0, 1000, 4000]]},
  {"on": "ax", "call": "set_xlabel", "args": ["time (s)"]},
  {"on": "ax", "call": "set_ylabel", "args": ["counts"]},
  {"on": "ax", "call": "set_title", "args": ["A title"]},
  {"on": "fig", "call": "suptitle", "args": ["Above everything"], "kwargs": {"y": 1.05}}
]}
