{"version": 1,
 "calls": [
  {"call": "subplots", "args": [1, 3], "kwargs": {"figsize": {"$tuple": [8.0, 3.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "scatter", "args": [[1, {"$float": "nan"}, 3, 4, 5], [2, 1, {"$float": "inf"}, 3, {"$float": "-inf"}]], "kwargs": {"label": "x or y bad"}},
  {"on": "axs[0]", "call": "scatter", "args": [[-35.5, 0.2, 7], [28.152176, -42, 3]], "kwargs": {"s": [25.0, {"$float": "nan"}, 64], "marker": "d", "label": "a size bad"}},
  {"on": "axs[0]", "call": "legend", "kwargs": {"loc": "upper left"}},
  {"on": "axs[1]", "call": "scatter", "args": [[0, 1, 2, 3, 4, 5], [5, 4, 3, 2, 1, 0]], "kwargs": {"c": [0.5, {"$float": "nan"}, 2, 3, 40, -1], "s": 80}},
  {"on": "axs[1]", "call": "scatter", "args": [[0, 1, {"$float": "nan"}, 3], [1, 1, 1, 1]], "kwargs": {"c": [1, 2, 3, 4], "cmap": "viridis"}},
  {"on": "axs[2]", "call": "set_xscale", "args": ["log"]},
  {"on": "axs[2]", "call": "scatter", "args": [[0.5, 1, {"$float": "nan"}, 10, 1e-07, 42], [1, 2, 3, 4, 5, 6]], "kwargs": {"s": 30}},
  {"on": "axs[2]", "call": "scatter", "args": [[3], [{"$float": "nan"}]], "kwargs": {"label": "all bad"}},
  {"on": "axs[2]", "call": "legend"}
 ]}
