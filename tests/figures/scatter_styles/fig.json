{"version": 1, "calls": [
  {"call": "subplots", "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[0, 4], [0, 4]]},
  {"on": "ax", "call": "scatter", "args": [[0, 1, 2], [1, 2, 3]], "kwargs": {"c": ["red", "#00ff00", "C4"], "edgecolors": "k", "linewidths": 2}},
  {"on": "ax", "call": "scatter", "args": [[1, 2, 3], [0.5, 1, 1.5]], "kwargs": {"marker": "x", "s": 60}},
  {"on": "ax", "call": "scatter", "args": [[2, 3, 4], [3, 3.5, 2]], "kwargs": {"marker": "^", "color": "purple", "alpha": 0.5, "s": [10, 40, 90]}},
  {"on": "ax", "call": "scatter", "args": [[3.5], [0.2]], "kwargs": {"facecolors": "none", "edgecolors": "C1", "s": 150}},
  {"on": "ax", "call": "scatter", "args": [[0.5, 1.5], [3.8, 0.2]], "kwargs": {"marker": "+", "linewidths": [1, 3], "zorder": 3}}
]}
