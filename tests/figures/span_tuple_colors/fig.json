{"version": 1, "calls": [
  {"call": "subplots", "args": [], "kwargs": {"figsize": {"$tuple": [6.0, 4.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "axvspan", "args": [0.0, 1.0], "kwargs": {"color": [0.2, 0.6, 0.3], "label": "RGB list"}},
  {"on": "ax", "call": "axvspan", "args": [1.0, 2.0], "kwargs": {"fc": {"$tuple": [0.8, 0.2, 0.2, 0.4]}, "ec": [0.0, 0.0, 0.5], "lw": 2, "label": "RGBA tuple face"}},
  {"on": "ax", "call": "axhspan", "args": [0.2, 0.4], "kwargs": {"facecolor": [0.1, 0.1, 0.9, 0.9], "alpha": 0.3, "label": "alpha over an RGBA"}},
  {"on": "ax", "call": "axhspan", "args": [0.6, 0.8], "kwargs": {"edgecolor": {"$tuple": [1.0, 0.5, 0.0, 0.5]}, "fill": false, "lw": 3, "label": "edge only"}},
  {"on": "ax", "call": "legend", "args": [], "kwargs": {"facecolor": [0.95, 0.95, 1.0], "edgecolor": {"$tuple": [0.0, 0.0, 0.5, 0.5]}, "loc": "lower right"}}
]}
