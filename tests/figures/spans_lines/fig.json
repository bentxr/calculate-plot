{"version": 1, "calls": [
  {"call": "subplots", "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[0, 1, 2], [0, 1, 4]]},
  {"on": "ax", "call": "axhline", "args": [2], "kwargs": {"color": "r", "ls": "--"}},
  {"on": "ax", "call": "axvline", "kwargs": {"x": 1.5, "ymin": 0.2, "ymax": 0.8}},
  {"on": "ax", "call": "axhspan", "args": [0.5, 1.5], "kwargs": {"alpha": 0.3}},
  {"on": "ax", "call": "axvspan", "args": [0.2, 0.6], "kwargs": {"color": "C2", "alpha": 0.2}},
  {"on": "ax", "call": "vlines", "args": [[0.5, 1.0], 0, [1, 2]]},
  {"on": "ax", "call": "hlines", "args": [3.5, 0, 2], "kwargs": {"colors": "k", "linestyles": "dotted"}}
]}
