{"version": 1, "calls": [
  {"call": "subplots", "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "vlines", "args": [[0, 1, 2, 3], 0, [1, 3, 2, 4]]},
  {"on": "ax", "call": "axhline", "args": [6], "kwargs": {"lw": 3, "alpha": 0.5}},
  {"on": "ax", "call": "axvline", "args": [-1]},
  {"on": "ax", "call": "hlines", "args": [[0.5, 1.5], [0, 1], 3], "kwargs": {"linestyles": "dashed", "linewidths": [1, 2], "colors": ["C1", "C2"]}},
  {"on": "ax", "call": "axvspan", "args": [1.2, 1.8], "kwargs": {"ymin": 0.1, "ymax": 0.5, "facecolor": "yellow", "edgecolor": "k", "lw": 2}},
  {"on": "ax", "call": "axhspan", "args": [4.5, 5], "kwargs": {"fill": false, "hatch": null, "ls": "--", "ec": "C3"}}
]}
