{"version": 1, "calls": [
  {"call": "figure", "kwargs": {"figsize": {"$tuple": [7.0, 4.0]}}, "as": "fig"},
  {"on": "fig", "call": "subfigures", "args": [1, 2], "kwargs": {"width_ratios": [2, 1], "wspace": 0.07}, "as": "sfigs"},
  {"on": "sfigs[0]", "call": "set_facecolor", "args": ["0.9"]},
  {"on": "sfigs[0]", "call": "subplots", "args": [2, 1], "kwargs": {"sharex": true}, "as": "axs"},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1, 2, 3], [1, 3, 2, 4]], "kwargs": {"label": "rising"}},
  {"on": "axs[1]", "call": "plot", "args": [[0, 1, 2, 3], [4, 2, 3, 1]], "kwargs": {"label": "falling", "color": "C1"}},
  {"on": "axs[0]", "call": "set_aspect", "args": [0.5]},
  {"on": "sfigs[0]", "call": "suptitle", "args": ["Left"]},
  {"on": "sfigs[1]", "call": "add_subplot", "args": [111], "kwargs": {"projection": "polar"}, "as": "p"},
  {"on": "p", "call": "plot", "args": [[0, 1, 2], [1, 2, 1]], "kwargs": {"label": "polar"}},
  {"on": "sfigs[1]", "call": "suptitle", "args": ["Right"], "kwargs": {"fontsize": "small"}},
  {"on": "sfigs[1]", "call": "text", "args": [0.05, 0.05, "text in a subfigure"]},
  {"on": "sfigs[1]", "call": "legend", "kwargs": {"loc": "lower right"}},
  {"on": "fig", "call": "suptitle", "args": ["Subfigures"], "kwargs": {"y": 1.0, "va": "top"}},
  {"on": "fig", "call": "legend", "kwargs": {"loc": "upper left", "fontsize": 7}}
]}
