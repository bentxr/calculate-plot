{"version": 1, "calls": [
  {"call": "subplots", "args": [], "kwargs": {"figsize": {"$tuple": [6.0, 4.5]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[0, 1, 2], [0, 1, 4]]},
  {"on": "ax", "call": "text", "args": [0.1, 3.5, "plain text"]},
  {"on": "ax", "call": "text", "args": [1.0, 1.0, "at the point"], "kwargs": {"color": "C3", "fontsize": 14}},
  {"on": "ax", "call": "text", "args": [0.5, 2.0, "turned"], "kwargs": {"rotation": 30, "ha": "center", "va": "center"}},
  {"on": "ax", "call": "text", "args": [1.5, 0.5, "two\nlines here"], "kwargs": {"horizontalalignment": "right", "verticalalignment": "top", "size": "large"}},
  {"on": "ax", "call": "text", "args": [1.9, 3.9, "sticks out of the axes"], "kwargs": {"va": "bottom"}},
  {"on": "ax", "call": "text", "kwargs": {"x": 0.2, "y": 0.2, "s": "by keywords"}},
  {"on": "ax", "call": "text", "args": [1.2, 2.6, "$\\frac{\\partial f}{\\partial x}=\\sqrt{x}$"], "kwargs": {"rotation": 45, "fontsize": 16}}
]}
