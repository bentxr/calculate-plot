{"version": 1, "calls": [
  {"call": "subplots", "args": [1, 2], "kwargs": {"figsize": {"$tuple": [9.0, 5.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "set_title", "args": ["office fly: -liga"], "kwargs": {"fontfeatures": ["-liga"]}},
  {"on": "axs[0]", "call": "set_xlabel", "args": ["affine fit: -liga, -kern"], "kwargs": {"fontfeatures": {"$tuple": ["-liga", "-kern"]}}},
  {"on": "axs[0]", "call": "set_ylabel", "args": ["office fly: none"], "kwargs": {"fontfeatures": null}},
  {"on": "axs[0]", "call": "text", "args": [0.5, 0.9, "office fly: default"], "kwargs": {"ha": "center", "fontsize": 14}},
  {"on": "axs[0]", "call": "text", "args": [0.5, 0.8, "office fly: -liga"], "kwargs": {"ha": "center", "fontsize": 14, "fontfeatures": ["-liga"]}},
  {"on": "axs[0]", "call": "text", "args": [0.5, 0.7, "office fly: liga=0"], "kwargs": {"ha": "center", "fontsize": 14, "fontfeatures": ["liga=0"]}},
  {"on": "axs[0]", "call": "text", "args": [0.5, 0.6, "office fly: empty"], "kwargs": {"ha": "center", "fontsize": 14, "fontfeatures": []}},
  {"on": "axs[0]", "call": "text", "args": [0.5, 0.5, "office fly: a string"], "kwargs": {"ha": "center", "fontsize": 14, "fontfeatures": "liga"}},
  {"on": "axs[0]", "call": "text", "args": [0.5, 0.4, "office fly: serif"], "kwargs": {"ha": "center", "fontsize": 14, "family": "serif", "fontfeatures": ["-liga"]}},
  {"on": "axs[0]", "call": "text", "args": [0.5, 0.3, "two lines: fi\noffice fly"], "kwargs": {"ha": "center", "fontfeatures": ["-liga"]}},
  {"on": "axs[0]", "call": "text", "args": [0.5, 0.15, "$fi$ math fi"], "kwargs": {"ha": "center", "fontfeatures": ["-liga"]}},
  {"on": "axs[0]", "call": "annotate", "args": ["fi fl: annotate", {"$tuple": [0.2, 0.05]}], "kwargs": {"fontfeatures": ["-liga"]}},
  {"on": "axs[0]", "call": "set_xticks", "args": [[0.25, 0.75]], "kwargs": {"labels": ["fi", "fl"], "fontfeatures": ["-liga"]}},
  {"on": "axs[1]", "call": "set_title", "args": ["бгдпт бгдпт"], "kwargs": {"language": [{"$tuple": ["sr", 0, 5]}, {"$tuple": ["ru", 6, 11]}]}},
  {"on": "axs[1]", "call": "text", "args": [0.5, 0.9, "бгдпт бгдпт: sr, ru"], "kwargs": {"ha": "center", "fontsize": 16, "language": [{"$tuple": ["sr", 0, 5]}, {"$tuple": ["ru", 6, 11]}]}},
  {"on": "axs[1]", "call": "text", "args": [0.5, 0.8, "бгдпт бгдпт: ru, sr"], "kwargs": {"ha": "center", "fontsize": 16, "language": {"$tuple": [{"$tuple": ["ru", 0, 5]}, {"$tuple": ["sr", 6, 11]}]}}},
  {"on": "axs[1]", "call": "text", "args": [0.5, 0.7, "бгдпт бгдпт: sr in part"], "kwargs": {"ha": "center", "fontsize": 16, "language": [{"$tuple": ["sr", 2, 8]}]}},
  {"on": "axs[1]", "call": "text", "args": [0.5, 0.6, "бгдпт бгдпт: overlaps"], "kwargs": {"ha": "center", "fontsize": 16, "language": [{"$tuple": ["sr", 0, 11]}, {"$tuple": ["ru", 3, 8]}]}},
  {"on": "axs[1]", "call": "text", "args": [0.5, 0.5, "бгдпт бгдпт: no ranges"], "kwargs": {"ha": "center", "fontsize": 16, "language": []}},
  {"on": "axs[1]", "call": "text", "args": [0.5, 0.4, "бгдпт бгдпт: unknown, sr"], "kwargs": {"ha": "center", "fontsize": 16, "language": [{"$tuple": ["no such language", 0, 5]}, {"$tuple": ["sr", 6, 11]}]}},
  {"on": "axs[1]", "call": "text", "args": [0.5, 0.3, "бгдпт fi: sr, -liga"], "kwargs": {"ha": "center", "fontsize": 16, "language": "sr", "fontfeatures": ["-liga"]}},
  {"on": "axs[1]", "call": "text", "args": [0.5, 0.2, "бгдпт: italic, sr, true"], "kwargs": {"ha": "center", "fontsize": 16, "style": "italic", "language": [{"$tuple": ["sr", true, 5]}]}},
  {"on": "fig", "call": "suptitle", "args": ["бгдпт office: sr, -liga"], "kwargs": {"language": [{"$tuple": ["sr", 0, 5]}], "fontfeatures": ["-liga"]}},
  {"on": "fig", "call": "text", "args": [0.02, 0.02, "fig.text: office"], "kwargs": {"fontfeatures": ["-liga"]}}
]}
