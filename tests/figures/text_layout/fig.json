{"version": 1, "calls": [
  {"call": "subplots", "args": [], "kwargs": {"figsize": {"$tuple": [7.0, 5.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "set_xlim", "args": [0, 10]},
  {"on": "ax", "call": "set_ylim", "args": [0, 10]},
  {"on": "ax", "call": "grid", "args": [true]},
  {"on": "ax", "call": "text", "args": [1, 9, "vertical"], "kwargs": {"rotation": "vertical", "va": "top"}},
  {"on": "ax", "call": "text", "args": [2, 9, "horizontal"], "kwargs": {"rotation": "horizontal"}},
  {"on": "ax", "call": "text", "args": [2, 8, "rotation None"], "kwargs": {"rotation": null}},
  {"on": "ax", "call": "text", "args": [2, 6, "400 degrees"], "kwargs": {"rotation": 400}},
  {"on": "ax", "call": "text", "args": [4, 9, "minus 30"], "kwargs": {"rotation": -30}},
  {"on": "ax", "call": "text", "args": [6, 8, "spaced\nlines\nof text"], "kwargs": {"linespacing": 2.0}},
  {"on": "ax", "call": "text", "args": [8, 8, "normal\nline\nspacing"], "kwargs": {"linespacing": "normal"}},
  {"on": "ax", "call": "text", "args": [8, 5.5, "spacing\nNone"], "kwargs": {"linespacing": null}},
  {"on": "ax", "call": "text", "args": [5, 5, "centred lines\nin a block\non the right"], "kwargs": {"ma": "center", "ha": "right"}},
  {"on": "ax", "call": "text", "args": [5, 3.5, "lines to the right\nin a block\nat the left"], "kwargs": {"multialignment": "right", "ha": "left"}},
  {"on": "ax", "call": "text", "args": [9.5, 0.5, "ma None\nfollows ha"], "kwargs": {"multialignment": null, "ha": "right"}},
  {"on": "ax", "call": "text", "args": [1, 4, "anchor mode"], "kwargs": {"rotation": 40, "rotation_mode": "anchor", "ha": "right", "va": "top"}},
  {"on": "ax", "call": "text", "args": [1, 4, "default mode"], "kwargs": {"rotation": 40, "rotation_mode": "default", "ha": "right", "va": "top", "color": "C1"}},
  {"on": "ax", "call": "text", "args": [1, 2, "xtick mode"], "kwargs": {"rotation": 40, "rotation_mode": "xtick", "color": "C2"}},
  {"on": "ax", "call": "text", "args": [3, 2, "ytick mode"], "kwargs": {"rotation": 40, "rotation_mode": "ytick", "color": "C3"}},
  {"on": "ax", "call": "text", "args": [3, 1, "mode None"], "kwargs": {"rotation": 10, "rotation_mode": null, "va": "center_baseline"}},
  {"on": "ax", "call": "text", "args": [7, 4, "top"], "kwargs": {"va": "top"}},
  {"on": "ax", "call": "text", "args": [7.6, 4, "bottom"], "kwargs": {"va": "bottom"}},
  {"on": "ax", "call": "text", "args": [8.6, 4, "center"], "kwargs": {"va": "center"}},
  {"on": "ax", "call": "text", "args": [9.4, 4, "long name"], "kwargs": {"verticalalignment": "center", "horizontalalignment": "center"}},
  {"on": "ax", "call": "text", "args": [6.5, 6.5, "ha wins over the long name"], "kwargs": {"horizontalalignment": "left", "ha": "right", "verticalalignment": "top", "va": "bottom", "multialignment": "left", "ma": "center"}}
]}
