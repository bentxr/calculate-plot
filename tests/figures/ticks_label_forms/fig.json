{"version": 1, "calls": [
  {"call": "subplots", "args": [1, 3], "kwargs": {"figsize": {"$tuple": [9.0, 3.0]}}, "as": ["fig", "axs"]},
  {"on": "axs[0]", "call": "plot", "args": [[0, 1, 2], [0, 1, 0.5]]},
  {"on": "axs[0]", "call": "set_xticks", "args": [[0, 1, 2]], "kwargs": {"labels": [1, 2.5, "c"]}},
  {"on": "axs[0]", "call": "set_yticks", "args": [[0, 0.5, 1], ["lo", "mid", "hi"]], "kwargs": {"rotation": 45, "color": "C1", "fontsize": 8}},
  {"on": "axs[1]", "call": "plot", "args": [[0, 1], [1, 100]]},
  {"on": "axs[1]", "call": "set_yscale", "args": ["log"]},
  {"on": "axs[1]", "call": "set_xticks", "args": [[0, 0.5, 1]]},
  {"on": "axs[1]", "call": "set_xticks", "args": [[0.25, 0.75]], "kwargs": {"labels": ["q1", "q3"], "minor": true, "color": "0.4", "fontstyle": "italic"}},
  {"on": "axs[1]", "call": "set_yticks", "args": [[2, 20, 50]], "kwargs": {"minor": true}},
  {"on": "axs[2]", "call": "plot", "args": [[0, 3], [0, 3]]},
  {"on": "axs[2]", "call": "set_xticks", "args": [[0, 1]], "kwargs": {"labels": ["a", "b"], "color": "red", "fontweight": "bold"}},
  {"on": "axs[2]", "call": "set_xticks", "args": [[0, 1, 2, 3]]},
  {"on": "axs[2]", "call": "set_yticks", "args": [[0, 1.5, 3]], "kwargs": {"labels": [true, null, -0.0]}}
]}
