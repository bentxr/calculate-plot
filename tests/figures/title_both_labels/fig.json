{"version": 1,
 "rc": {"xtick.labeltop": true, "xtick.top": true},
 "calls": [
  {"call": "subplots", "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[0, 1], [0, 3]]},
  {"on": "ax", "call": "set_title", "args": ["Labels above and below"]}
]}
