{"version": 1,
 "rc": {"xtick.labeltop": true, "xtick.top": true, "xtick.major.top": false},
 "calls": [
  {"call": "subplots", "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "plot", "args": [[2, 3, 6], [0, 3, 1]]},
  {"on": "ax", "call": "set_xscale", "args": ["log"]},
  {"on": "ax", "call": "set_title", "args": ["Minor labels on top only"]}
]}
