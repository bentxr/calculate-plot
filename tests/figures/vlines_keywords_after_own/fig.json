{"version": 1,
 "calls": [
  {"call": "subplots", "args": [], "kwargs": {"figsize": {"$tuple": [4.0, 3.0]}}, "as": ["fig", "ax"]},
  {"on": "ax", "call": "vlines", "args": [[1.5, 2.5], 0, 3], "kwargs": {"linestyle": "--", "linestyles": ":", "color": "blue", "colors": "red", "label": "v"}},
  {"on": "ax", "call": "hlines", "args": [[1.0, 2.0], 1, 3, "green", "dashdot"], "kwargs": {"lw": 3.0, "linewidths": 1.0, "label": "h"}},
  {"on": "ax", "call": "legend", "args": []}
]}
